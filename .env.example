# ===================================
# Foodlica 환경 변수 템플릿
# ===================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env

# ===================================
# Google Maps Platform API
# ===================================
# Google Cloud Console에서 발급받은 API 키
# 발급 방법: https://console.cloud.google.com/
# 필요한 API: Places API, Maps JavaScript API, Directions API
PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===================================
# 애플리케이션 설정
# ===================================
PUBLIC_APP_NAME=Foodlica
PUBLIC_APP_URL=http://localhost:5173

# ===================================
# 개발 환경
# ===================================
NODE_ENV=development
