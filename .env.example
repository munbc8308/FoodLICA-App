# ===================================
# Foodlica 환경 변수 템플릿
# ===================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env

# ===================================
# Google Maps Platform API
# ===================================
# Google Cloud Console에서 발급받은 API 키
# 발급 방법: https://console.cloud.google.com/
# 필요한 API: Places API, Maps JavaScript API, Directions API
PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBfPVL3ax4RrezJdLpIgEESJVKUgfN_9ig

# ===================================
# 애플리케이션 설정
# ===================================
PUBLIC_APP_NAME=Foodlica
PUBLIC_APP_URL=http://localhost:5173

# ===================================
# 데이터베이스 (Phase 3 이후)
# ===================================
# PostgreSQL 데이터베이스 연결 문자열
# 형식: postgresql://username:password@host:port/database
POSTGRES_HOST=7w3ym7.h.filess.io
POSTGRES_PORT=5432
POSTGRES_DATABASE=foodlica_svelte_canalbreak
POSTGRES_USER=foodlica_svelte_canalbreak
POSTGRES_PASSWORD=e950bf5c8ecdaa53bbf935815ff73af82f06d929
POSTGRES_SSL=false
POSTGRES_SCHEMA=your_schema_name
POSTGRES_POOL_MAX=5
POSTGRES_POOL_IDLE=10000
POSTGRES_POOL_TIMEOUT=5000



# ===================================
# 개발 환경
# ===================================
NODE_ENV=development

# ===================================
# 선택 사항
# ===================================
# 디버그 모드 (개발 시 API 호출 로깅)
# DEBUG=true

# API 캐시 TTL (초 단위, 기본값: 300초 = 5분)
# API_CACHE_TTL=300

# 검색 결과 최대 개수 (기본값: 20)
# MAX_SEARCH_RESULTS=20